# Gestionado por Ansible. Los KDC se encuentran por DNS (registros SRV de AD).
[libdefaults]
    default_realm = {{ ad_realm }}
    dns_lookup_realm = false
    dns_lookup_kdc = true
    rdns = false
    ticket_lifetime = 24h
    renew_lifetime = 7d
    forwardable = true

[domain_realm]
    .{{ ad_domain }} = {{ ad_realm }}
    {{ ad_domain }} = {{ ad_realm }}
